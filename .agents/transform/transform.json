{
  "symlinks": {
    ".claude/agents": "../.agents/agents",
    ".claude/hooks": "../.agents/hooks",
    ".claude/skills": "../.agents/skills",
    ".claude/mcp_headers.py": "../.agents/mcp_headers.py",
    ".claude/start-pyright-mcp.sh": "../.agents/start-pyright-mcp.sh"
  },
  "drop": [
    ".agents",
    ".codex",
    ".claude/hooks/codex_session_learnings.py",
    "tests/test_codex_hooks.py",
    "tests/test_generate_main.py",
    ".github/workflows/generate-main.yml",
    ".github/workflows/vendor-freshness.yml",
    ".claude/skills/arch",
    ".claude/skills/context",
    ".claude/skills/implement-from-plan",
    ".claude/skills/lint",
    ".claude/skills/plan",
    ".claude/skills/retro",
    ".claude/skills/run",
    ".claude/skills/test",
    ".claude/skills/full-review",
    ".claude/skills/loop-goal",
    ".claude/skills/prune-rules",
    ".claude/skills/search-second-brain",
    ".claude/skills/verify"
  ],
  "instructions": {
    "from": "AGENTS.md",
    "to": "CLAUDE.md"
  },
  "blocks": [
    {
      "note": "Two per-file-ignore keys collapse onto one path once .agents/ becomes .claude/.",
      "file": "pyproject.toml",
      "from": "\".agents/mcp_headers.py\" = [\"S603\", \"S607\"]\n\".claude/mcp_headers.py\" = [\"S603\", \"S607\"]\n",
      "to": "\".claude/mcp_headers.py\" = [\"S603\", \"S607\"]\n"
    },
    {
      "note": "Layer A reaches this repo two ways, and never both at once. On v2 it is the vendored tree under .agents/vendor/harness, which the .agents drop removes here; on main it is the plugin, which nothing else in the tree would enable.",
      "file": ".claude/settings.json",
      "from": "  \"enabledPlugins\": {\n    \"mattpocock-skills@claude-plugins-official\": true\n  },\n",
      "to": "  \"enabledPlugins\": {\n    \"harness@harness\": true,\n    \"mattpocock-skills@claude-plugins-official\": true\n  },\n"
    }
  ],
  "substitutions": [
    {
      "note": "Every reference to the canonical directory, as a path fragment.",
      "from": ".agents/",
      "to": ".claude/"
    },
    {
      "note": "And as a path *segment* \u2014 `Path(...) / \".agents\" / \"hooks\"` never contains a slash.",
      "regex": "([\"'])\\.agents\\1",
      "to": "\\1.claude\\1"
    },
    {
      "note": "The instruction file itself, in prose and in glob patterns.",
      "regex": "\\bAGENTS\\.md\\b",
      "to": "CLAUDE.md"
    }
  ]
}
