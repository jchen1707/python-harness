# Normalize line endings to LF in the repo and working tree (cross-platform).
# Keeps pre-commit's mixed-line-ending (--fix=lf) from fighting the working copy
# on Windows checkouts.
* text=auto eol=lf

# Generated lockfile — collapse in GitHub diffs; stays committed for reproducibility.
uv.lock linguist-generated=true

# Binary assets — never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary