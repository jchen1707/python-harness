{
  "permissions": {
    "allow": [
      "Bash(uv sync)",
      "Bash(uv sync:*)",
      "Bash(uv lock)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run uvicorn:*)",
      "Bash(uv run pre-commit:*)",
      "Bash(pre-commit run:*)",
      "Bash(pre-commit install)",
      "Bash(docker compose:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./.env.test)",
      "Bash(cat .env:*)",
      "Bash(cat ./.env:*)",
      "Bash(source .env:*)",
      "Bash(type .env:*)",
      "Bash(more .env:*)",
      "Bash(less .env:*)",
      "Bash(head .env:*)",
      "Bash(tail .env:*)",
      "Bash(nl .env:*)",
      "Bash(strings .env:*)",
      "Bash(Get-Content .env:*)",
      "Bash(gc .env:*)",
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(set)",
      "Bash(export)",
      "Bash(export -p:*)",
      "Bash(declare -x:*)",
      "Bash(typeset -x:*)",
      "Bash(compgen -e:*)",
      "Bash(Get-ChildItem Env:*)",
      "Bash(gci Env:*)",
      "Bash(ls Env:*)",
      "Bash(dir Env:*)",
      "Bash(Get-Variable:*)",
      "Bash(echo $LINEAR_API_KEY:*)",
      "Bash(echo \"$LINEAR_API_KEY\":*)",
      "Bash(echo ${LINEAR_API_KEY}:*)",
      "Bash(echo $env:LINEAR_API_KEY:*)",
      "Bash(echo $GH_TOKEN:*)",
      "Bash(echo \"$GH_TOKEN\":*)",
      "Bash(echo ${GH_TOKEN}:*)",
      "Bash(echo $env:GH_TOKEN:*)",
      "Bash(python -c:*)",
      "Bash(python3 -c:*)",
      "Bash(uv run python -c:*)",
      "Bash(node -e:*)",
      "Bash(node -p:*)"
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  },
  "plansDirectory": ".agents/plans",
  "enabledMcpjsonServers": [
    "pyright-lsp",
    "linear"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|mcp__.*(edit|write|create|apply).*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "python",
              "${CLAUDE_PROJECT_DIR}/.agents/hooks/protect_paths.py"
            ],
            "timeout": 30,
            "statusMessage": "Checking protected paths…"
          }
        ]
      },
      {
        "matcher": "Read|Bash|mcp__.*read.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "python",
              "${CLAUDE_PROJECT_DIR}/.agents/hooks/protect_secrets.py"
            ],
            "timeout": 30,
            "statusMessage": "Checking secret boundaries…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|mcp__.*(edit|write|create|apply).*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "python",
              "${CLAUDE_PROJECT_DIR}/.agents/hooks/format_edited.py"
            ],
            "timeout": 90,
            "statusMessage": "Formatting…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "python",
              "${CLAUDE_PROJECT_DIR}/.agents/hooks/verify.py"
            ],
            "timeout": 600,
            "statusMessage": "Verifying Definition of Done…"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "python",
              "${CLAUDE_PROJECT_DIR}/.agents/hooks/session_learnings.py"
            ],
            "timeout": 300,
            "statusMessage": "Distilling session learnings…"
          }
        ]
      }
    ]
  }
}
