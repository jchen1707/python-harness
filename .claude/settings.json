{
  "permissions": {
    "allow": [
      "Bash(uv sync)",
      "Bash(uv sync:*)",
      "Bash(uv lock)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run uvicorn:*)",
      "Bash(uv run pre-commit:*)",
      "Bash(pre-commit run:*)",
      "Bash(pre-commit install)",
      "Bash(docker compose:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true
  },
  "plansDirectory": ".claude/plans",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect_paths.py"
            ],
            "timeout": 30,
            "statusMessage": "Checking protected paths…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/format_edited.py"
            ],
            "timeout": 90,
            "statusMessage": "Formatting…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/verify.py"
            ],
            "timeout": 600,
            "statusMessage": "Verifying Definition of Done…"
          }
        ]
      }
    ]
  }
}
