# Copy to .env and fill in. NEVER commit .env.
# Loaded by app.config.Settings (pydantic-settings) once application code exists.

# --- Application ---
APP_NAME=python-harness
LOG_LEVEL=INFO

# --- Anthropic (agents) ---
# Default model per AGENTS.md: claude-opus-4-8 for hard tasks/planning. Override
# to claude-sonnet-4-6 for high-volume routine work.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Voyage AI (embeddings) ---
# Anthropic has no embeddings API; Voyage is the recommended partner.
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-3

# --- Postgres + pgvector (vector store) ---
# Matches docker-compose.yml. Start the DB with `docker compose up -d db`.
POSTGRES_DSN=postgresql://harness:harness@localhost:5432/harness
PGVECTOR_COLLECTION=app_vectors
PGVECTOR_DIMENSION=1024

# --- GitHub (PR / release automation via gh CLI / GitHub API) ---
# Personal access token (classic) with repo + workflow scopes, OR a fine-grained token
# with Contents:RW + Pull requests:RW + Workflows:RW. The gh CLI reads GH_TOKEN for
# non-interactive auth. NEVER commit a real token.
GH_TOKEN=