# Copy to .env and fill in. NEVER commit .env.
# Loaded by app.core.config.Settings (pydantic-settings) — the only reader of the
# environment. No other module reads env vars or .env.

# --- Application (app Settings; see app.core.config.Settings) ---
# Four app Settings fields. Required fields (DATABASE_URL, VOYAGE_API_KEY) have no
# default and raise ValidationError at startup when absent.
DATABASE_URL=postgresql://harness:harness@localhost:5432/harness
VOYAGE_API_KEY=
SIMILARITY_THRESHOLD=0.0
LOG_LEVEL=INFO

# --- Harness dev-workflow (not app Settings) ---
APP_NAME=python-harness

# --- Anthropic (agents; harness dev-workflow, not app Settings) ---
# Default model per CLAUDE.md: claude-opus-4-8 for hard tasks/planning. Override
# to claude-sonnet-4-6 for high-volume routine work.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- GitHub (PR / release automation via gh CLI / GitHub API) ---
# Personal access token (classic) with repo + workflow scopes, OR a fine-grained token
# with Contents:RW + Pull requests:RW + Workflows:RW. The gh CLI reads GH_TOKEN for
# non-interactive auth. NEVER commit a real token.
GH_TOKEN=