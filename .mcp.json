{
  "mcpServers": {
    "pyright-lsp": {
      "command": "mcp-language-server",
      "args": ["--workspace", ".", "--lsp", "pyright-langserver", "--", "--stdio"]
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp",
      "headers": {
        "Authorization": "Bearer ${LINEAR_API_KEY}"
      }
    }
  }
}
