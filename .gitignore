# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Virtual envs
.venv/
venv/
env/

# uv
.uv/

# Testing / typing / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Env / secrets — NEVER commit
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Claude Code — personal/local only (shared config is committed)
.claude/settings.local.json
.claude/.credentials.json
.claude/scheduled_tasks.json
.claude/plans/
.claude/todos/

# .claude/skills/ IS committed — it holds repo-owned skills only (real files, no
# symlinks). Third-party skills come from the mattpocock-skills plugin, declared in
# .claude/settings.json → enabledPlugins; the plugin's own files live outside the repo
# under ~/.claude/plugins/ and must never be vendored back in here.