# OS
.DS_Store
Thumbs.db

# Claude Code — personal/local only (shared config is committed)
.claude/settings.local.json
.claude/.credentials.json
.claude/scheduled_tasks.json
.claude/plans/
.claude/todos/

# Vendored skills: .agents/skills + skills-lock.json ARE committed, but
# .claude/skills/ is machine-local — `npx skills` writes absolute-path symlinks
# (/c/Users/<you>/...) and core.symlinks=false on Windows would commit them as
# broken text stubs. Regenerate after clone with:  npx skills add mattpocock/skills
.claude/skills/